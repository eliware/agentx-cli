{
  "name": "@eliware/agentx-cli",
  "type": "module",
  "version": "8.0.0",
  "description": "A lightweight terminal chat agent built on the OpenAI Responses API through the official @eliware/openai client.",
  "main": "agentx.mjs",
  "scripts": {
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "test": "eliware-test",
    "pack": "eliware-test --pack",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/agentx-cli"
  },
  "keywords": [
    "agentx",
    "openai",
    "responses-api",
    "cli",
    "terminal",
    "websocket"
  ],
  "author": "Eliware (Eli Sterling) <eli@eliware.org>",
  "license": "MIT",
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "bugs": {
    "url": "https://github.com/eliware/agentx-cli/issues"
  },
  "homepage": "https://github.com/eliware/agentx-cli#readme",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ]
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/openai": "^1.1.11",
    "@eliware/redact": "^6.0.0",
    "dotenv": "^18.0.4",
    "sharp": "^0.35.4",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "bin": {
    "agentx": "./bin/agentx.mjs",
    "agentx-setup": "./bin/agentx-setup.mjs"
  },
  "files": [
    "agentx.mjs",
    "agentx-setup.mjs",
    "bin/",
    "prompt.json",
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "LICENSE.md",
    "RELEASE_NOTES.md",
    "specs/"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "eliware": {
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ],
    "authority": {
      "authoritativeFor": [
        "AgentX CLI repository implementation and npm publication metadata"
      ],
      "notAuthoritativeFor": [
        "Eliware documentation, operations, deployment, and external platform state"
      ]
    },
    "crosslinks": [
      {
        "path": "../docs/authority-map.json",
        "relation": "relatedAuthority",
        "authoritativeFor": "Cross-repository documentation authority"
      },
      {
        "path": "../operations/authority-map.json",
        "relation": "relatedAuthority",
        "authoritativeFor": "Cross-cutting operational authority"
      }
    ]
  }
}

{
  "model": "gpt-5.6-luna",
  "input": [
    {
      "role": "developer",
      "content": [
        {
          "type": "input_text",
          "text": ""
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "<user message goes here>"
        }
      ]
    }
  ],
  "text": {
    "format": {
      "type": "text"
    },
    "verbosity": "low"
  },
  "reasoning": {
    "effort": "medium",
    "mode": "standard",
    "summary": null
  },
  "context_management": [
    {
      "type": "compaction",
      "compact_threshold": 200000
    }
  ],
  "tools": [
    {
      "type": "web_search",
      "user_location": {
        "type": "approximate"
      },
      "search_context_size": "medium"
    },
    {
      "type": "shell",
      "environment": {
        "type": "local"
      }
    },
    {
      "type": "function",
      "name": "spawn_agent",
      "description": "Start independent AgentX workers asynchronously with read, write, or execute permissions. Returns agent IDs immediately.",
      "parameters": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "description": "Independent worker instructions.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "permissions": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "execute"
            ],
            "description": "Worker permission level. Defaults to execute."
          },
          "debug": {
            "type": "boolean",
            "description": "Enable --debug output in the worker. Defaults to false."
          }
        },
        "required": [
          "tasks"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "cancel_agent",
      "description": "Cancel active AgentX workers that are hung, stalled, or off task.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": [
          "agent_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "agent_status",
      "description": "Get worker status and a small log view. Defaults to the last 2048 bytes; supports byte-based pagination and regex search.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "wait": {
            "type": "boolean",
            "description": "Wait until all requested workers finish. Defaults false."
          },
          "timeout_ms": {
            "type": "integer",
            "description": "Maximum wait time when wait is true. 0 means no limit.",
            "minimum": 0
          },
          "output_bytes": {
            "type": "integer",
            "description": "Number of output bytes to return. Defaults to 2048; maximum 8192.",
            "minimum": 1,
            "maximum": 8192
          },
          "output_offset": {
            "type": "integer",
            "description": "Number of bytes to skip backward from the end. Defaults to 0. Ignored when search is set.",
            "minimum": 0
          },
          "search": {
            "type": "string",
            "description": "Regular expression applied to the retained log; returns matching lines instead of a paginated tail."
          }
        },
        "required": [
          "agent_ids"
        ],
        "additionalProperties": false
      }
    }    ,{
      "type": "function",
      "name": "goal_complete",
      "description": "Declare the active goal complete only after verifying it. Include a concise summary and evidence.",
      "parameters": {"type":"object","properties":{"summary":{"type":"string"},"evidence":{"type":"string"}},"required":["summary","evidence"],"additionalProperties":false}
    },
    {
      "type": "function",
      "name": "goal_blocked",
      "description": "Ask the user for information required to continue the active goal. Provide 2-4 choices when useful.",
      "parameters": {"type":"object","properties":{"question":{"type":"string"},"choices":{"type":"array","items":{"type":"string"},"minItems":2,"maxItems":4}},"required":["question"],"additionalProperties":false}
    }
  ],
  "store": true,
  "include": [
    "reasoning.encrypted_content",
    "web_search_call.action.sources"
  ]
}

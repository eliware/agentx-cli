{
  "model": "gpt-5.6-luna",
  "input": [
    {
      "role": "developer",
      "content": [
        {
          "type": "input_text",
          "text": ""
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "<user message goes here>"
        }
      ]
    }
  ],
  "text": {
    "format": {
      "type": "text"
    },
    "verbosity": "low"
  },
  "reasoning": {
    "effort": "medium",
    "mode": "standard",
    "summary": null
  },
  "context_management": [
    {
      "type": "compaction",
      "compact_threshold": 200000
    }
  ],
  "tools": [
    {
      "type": "web_search",
      "user_location": {
        "type": "approximate"
      },
      "search_context_size": "medium"
    },
    {
      "type": "shell",
      "environment": {
        "type": "local"
      }
    },
    {
      "type": "function",
      "name": "spawn_agent",
      "description": "Start independent AgentX workers asynchronously with read, write, or execute permissions. Returns agent IDs immediately.",
      "parameters": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "description": "Independent worker instructions.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "permissions": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "execute"
            ],
            "description": "Worker permission level. Defaults to execute."
          }
        },
        "required": [
          "tasks"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "cancel_agent",
      "description": "Cancel active AgentX workers that are hung, stalled, or off task.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": ["agent_ids"],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "agent_status",
      "description": "Get progress, partial output, timing, and usage for spawned workers.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "wait": {
            "type": "boolean",
            "description": "Wait until all requested workers finish. Defaults false."
          },
          "timeout_ms": {
            "type": "integer",
            "description": "Maximum wait time when wait is true. 0 means no limit.",
            "minimum": 0
          }
        },
        "required": [
          "agent_ids"
        ],
        "additionalProperties": false
      }
    }
  ],
  "store": true,
  "include": [
    "reasoning.encrypted_content",
    "web_search_call.action.sources"
  ]
}
